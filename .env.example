# ============================================================
# ИРФАН — Аруу жүрөк | Environment Variables
# ============================================================
# Бул файлды .env катары көчүрүп, маанилерди толтуруңуз:
#   cp .env.example .env
# .env файлы эч качан Git'ке коммит кылынбайт!
# ============================================================

# ----------------------------------------------------------
# Django Core
# ----------------------------------------------------------

# Узун, кокустук жашыруун ачкыч. Генерациялоо үчүн:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Жергиликтүү иштетүүдө True, production'до False
DEBUG=False

# Уруксат берилген хосттор (үтүр менен бөлүнгөн)
# Мисал: mysite.vercel.app,mysite.kg,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF үчүн ишенимдүү origins (үтүр менен бөлүнгөн)
# Мисал: https://mysite.vercel.app,https://mysite.kg
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ----------------------------------------------------------
# База данных
# ----------------------------------------------------------

# Production PostgreSQL (Neon, Supabase, Railway же башка)
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL жок болсо → SQLite колдонулат (локалдык разработка)
DATABASE_URL=

# ----------------------------------------------------------
# Коопсуздук (production'до)
# ----------------------------------------------------------

# Vercel SSL'ди өзү башкарат → False болушу керек (loop болбосун)
SECURE_SSL_REDIRECT=False

# HSTS: production'до 31536000 (1 жыл), тестте 0
SECURE_HSTS_SECONDS=0
